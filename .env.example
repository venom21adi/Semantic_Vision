# Copy this file to .env and fill in what you need -- .env itself is
# gitignored. Nothing here is required to run `docker compose up`; every
# variable has a sensible default or is simply optional.

# Host path to the repository you want to inspect. Mounted read-only at
# /workspace/repo inside the backend container -- paste this same path
# (or a subfolder of it) into the app's own "Repository path" field and
# it's translated automatically, or type /workspace/repo directly if you
# prefer. Defaults to this project's own repo if left blank, so
# `docker compose up` works with zero setup -- in that default case,
# only /workspace/repo works, since there's no host path configured yet
# to translate from.
REPO_PATH=

# AI documentation providers -- set only the ones you plan to use. Leave
# a key blank rather than putting a placeholder in it: a blank value is
# treated as "not configured" (a clear error if you try to use that
# provider anyway), while a fake placeholder gets sent as a real,
# invalid credential and fails with a more confusing auth error instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SEMANTIC_VISION_OPENAI_MODEL=
SEMANTIC_VISION_ANTHROPIC_MODEL=
SEMANTIC_VISION_OLLAMA_MODEL=

# Ollama running on your host machine (not inside a container) is
# reachable from the backend container at this address by default.
OLLAMA_API_BASE=http://host.docker.internal:11434
