# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.claude/
.github/

# Internal planning/progress docs (roadmap, build plans, progress log, lessons
# learned, half-baked ideas) -- kept locally for context, not pushed publicly.
docs/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# vscode-extension: the bundled backend binary (built per-platform by CI --
# see scripts/pyinstaller/backend.spec -- and copied into bin/ just before
# packaging) and packaged .vsix output are both build artifacts, not source.
vscode-extension/bin/
*.vsix

# Semantic Vision persisted repo state (written into whatever repo you inspect,
# including test fixtures if you load one through a locally running app)
.visualiser/

# Local runtime logs, and Docker's local env overrides
*.log
.env

# Vercel CLI's local project link (project/org IDs) -- created only if
# `vercel` is ever run from this machine, never meant to be shared.
# vercel.json itself (the deploy config) stays tracked -- Vercel's build
# reads it from the repo, same as any other build config.
.vercel
